# Copy this file as .env and fill it in. Keys go ONLY here (and in Render), never in a chat or in git: .env is ignored by git.
# Empty means "not set".

# ─── The dashboard (your computer) ───────────────────────────────────────────
PORT=3001
# Any username/password you choose. Leave both empty while it only runs on your computer; set both if it is ever reachable
# from the internet (anyone with the URL would see your leads and could trigger real sends).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# ─── Your own details ────────────────────────────────────────────────────────
# They sign every email and fill its legal footer, and the lead's page names your brand in the consent.
# LEGAL_FOOTER is required by law (CAN-SPAM) in every commercial email to the US: your company and postal address, e.g.
#   LEGAL_FOOTER=My Company LLC · 123 Main St, Miami, FL 33101, USA
# Until the three are filled the email text has gaps ([[BRAND_NAME]]…) and the app refuses to send it.
BRAND_NAME=
SENDER_NAME=
LEGAL_FOOTER=

# ─── Supabase (the database) ─────────────────────────────────────────────────
# Project Settings → API Keys: the project URL and the "service_role" (secret) key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# UUID of a user of your project (Authentication → Users → "User UID"). Every lead row carries it.
NEW_LEADS_OWNER_USER_ID=

# ─── Anthropic (Claude writes the text of each demo website) ─────────────────
# Needs credit in your Anthropic account: without it every demo fails. Each site costs about $0.02–0.14.
ANTHROPIC_API_KEY=

# ─── Vercel (publishes each demo website) ────────────────────────────────────
# Account Settings → Tokens. VERCEL_SCOPE is your team's slug (e.g. "your-name-projects"): the Vercel CLI needs it to publish.
VERCEL_TOKEN=
VERCEL_SCOPE=

# ─── Instantly (sends the emails) ────────────────────────────────────────────
# API v2 key: Settings → Integrations → API Keys (with permission for leads and campaigns)
INSTANTLY_API_KEY=
# UUID of each Instantly campaign. Print the text to paste in each one with: npm run leads:email-template (add -- --maps for Maps)
#   INSTANTLY_CAMPAIGN_ID        new Connecticut LLCs with a Latino owner, in Spanish
#   INSTANTLY_CAMPAIGN_ID_MAPS   Google Maps businesses without a website (Florida, Texas, New Jersey), in English
INSTANTLY_CAMPAIGN_ID=
INSTANTLY_CAMPAIGN_ID_MAPS=
# Public https address of your campaign server on Render (e.g. https://your-campaign.onrender.com): the links in the emails point there
CAMPAIGN_PUBLIC_URL=
# true: every lead first gets its own demo website, and only leads whose site is ready are sent ({{web}} in the email)
LEAD_DEMOS=true
# Test mode: true = nothing is sent to Instantly (it is only written to the log). Telegram alerts still reach you.
# Set it to false when you have tried everything with your own email.
OUTREACH_DRY_RUN=true

# ─── Telegram (alerts on your phone: someone asks for a call or replies) ─────
# Create a bot with @BotFather, put its token here, send it any message and run: npm run telegram:setup (it finds the chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Apify (only for the Google Maps campaign) ───────────────────────────────
# Console → Settings → API & Integrations. The free plan gives $5 a month: the Maps search uses that up in a couple of days.
APIFY_TOKEN=
# Daily search size (each search = one city + 3 categories; ≈ $0.006 per place, ≈ $0.015 per Facebook email lookup)
MAPS_RUNS_PER_DAY=2
MAPS_MAX_PER_SEARCH=40
MAPS_LOOKUPS_PER_RUN=60
# Optional: another Apify actor for the Maps search (default compass~crawler-google-places)
APIFY_MAPS_ACTOR=

# ─── Render (your campaign server) ───────────────────────────────────────────
# Account Settings → API Keys. The "caja de claves" (http://localhost:3001/claves.html) uses it to create your server with
# all the values of this file, and fills in RENDER_SERVICE_ID and CAMPAIGN_PUBLIC_URL.
RENDER_API_KEY=
RENDER_SERVICE_ID=

# ─── Optional ────────────────────────────────────────────────────────────────
# Free app token from data.ct.gov (avoids being throttled when downloading the registry): https://data.ct.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=
# API key of a paid email verifier (hook ready in src/services/emailVerify.js, no provider wired yet)
EMAIL_VERIFIER_API_KEY=
